<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>University Cafeteria</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Cafeteria" asp-action="Index">
                University Cafeteria
            </a>

            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Cafeteria" asp-action="Index">Home</a>
                <a class="nav-link" asp-controller="Cafeteria" asp-action="Products">Products</a>
                <a class="nav-link" asp-controller="Cafeteria" asp-action="Suppliers">Suppliers</a>
                <a class="nav-link" asp-controller="Cafeteria" asp-action="SupplyStatus">Supply Status</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center border-top py-3">
        University Cafeteria &copy; 2026
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>